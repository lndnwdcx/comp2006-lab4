*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# =======================================================
# TODO: IMPLEMENT YOUR IPTABLES RULES BELOW
# =======================================================

# --- 1. ALLOW ESTABLISHED & RELATED TRAFFIC ---
-A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# --- 2. BLACKLIST / THREAT MITIGATION ---
-A FORWARD -s 172.16.1.200 -j DROP

# --- 3. LAN TO DMZ & WAN ACCESS ---
#Lan to DMZ access
-A FORWARD -i eth1 -s 10.1.1.0/24 -d 192.168.10.0/24 -j ACCEPT
#Lan to WAN access
-A FORWARD -i eth1 -s 10.1.1.0/24 -o eth3 -j ACCEPT

# --- 4. WAN TO DMZ ACCESS ---
#Allow WAN client to DMZ webserver with http
-A FORWARD -i eth3 -o eth2 -d 192.168.10.10 -p tcp --dport 80 -j ACCEPT
#Allow WAN client to DMZ webserver with https
-A FORWARD -i eth3 -o eth2 -d 192.168.10.10 -p tcp --dport 443 -j ACCEPT


COMMIT

